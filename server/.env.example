# MongoDB
MONGODB_URI=mongodb://localhost:27017/mathsblitz

# HTTP Server
PORT=4000
CLIENT_URL=http://localhost:3000

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=7d

# ── On-chain Escrow (Phase 3) ───────────────────────────────────────────────
# Leave blank to run in escrow-disabled mode (no staking, no settlement).
CELO_NETWORK=alfajores
CELO_RPC_URL=https://alfajores-forno.celo-testnet.org
ESCROW_CONTRACT_ADDRESS=
# Private key of the authorised settlement signer (0x-prefixed, funded with CELO for gas)
SETTLEMENT_PRIVATE_KEY=
